# ----------------------------------------------------------------------------
# .gitignore for opencode/ (llmstack)
#
# Single source of truth = ./models.ini.
# Everything else under llmstack/ that's auto-generated, downloaded, or runtime
# state is excluded from version control - it is reproducible from:
#
#   bash llmstack/llmstack.sh setup        # downloads + generates configs
#   bash llmstack/llmstack.sh install      # generates configs only
#
# Tracked things you SHOULD see in `git status`:
#   models.ini
#   llmstack/README.md, UPGRADING.md, requirements.txt
#   llmstack/src/*.py
#   llmstack/llmstack.sh   (single entry point for all stack actions)
# ----------------------------------------------------------------------------

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / IDE ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- llmstack runtime state -------------------------------------------------
# Per-cwd .run/ directory, created wherever `llmstack.sh` is invoked.
# Contains: opencode.json, AGENTS.md (copy of template), pid files,
# active-channel marker, llama-swap.next.yaml sidecar, llmstack.bashrc /
# zdotdir for prompt prefix, logs/llama-swap.log, logs/router.log,
# logs/dl-*.log. All regenerated on demand.
.run/

# Legacy log path (logs are now under .run/logs/). Kept here so old logs
# left over from earlier versions of the script don't get accidentally
# committed.
llmstack/logs/

# --- Vendored binary --------------------------------------------------------
# Mach-O arm64 binary, ~14 MB. Re-download from:
#   https://github.com/mostlygeek/llama-swap/releases
llmstack/bin/llama-swap

# --- Auto-generated configs -------------------------------------------------
# Auto-generated from models.ini via:
#   - llmstack/src/gen_llama_swap_yaml.py  -> llmstack/llama-swap.yaml
#   - llmstack/src/gen_opencode_config.py  -> <work-dir>/.run/opencode.json
# (the latter is covered by the .run/ rule above)
# Regenerate with: bash llmstack/llmstack.sh install
llmstack/llama-swap.yaml

# Legacy: project-root opencode.json was a manual seed before the installer
# existed. Real one now lives at <work-dir>/.run/opencode.json and is
# rendered fresh by `llmstack.sh install`. Safe to delete from disk.
/opencode.json

# --- Install-time artefacts -------------------------------------------------
# In-flight temp files from mktemp (cleaned up by trap RETURN, but may
# linger if the script is killed mid-render).
.opencode.json.*
.llama-swap.yaml.*
